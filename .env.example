# Settings for `docker compose up`. Copy to .env (next to docker-compose.yml) and fill in.
# The API and worker refuse to start in production if a secret below is missing,
# shorter than 32 characters, or a placeholder.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Database password (use the generated hex value: other characters can break the URL).
POSTGRES_PASSWORD=

# Signs login sessions. Changing it signs everyone out.
JWT_SECRET=

# Encrypts saved connection passwords. Never change it once set,
# or saved connections can no longer be decrypted.
ENCRYPTION_KEY=

# Public addresses once deployed (HTTPS):
#   CORS_ORIGINS  = your website, allowed to sign in and call the API
#   VITE_API_URL  = your API, baked into the website when it's built
CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:3000

# Use "none" only when the website and API are on different domains (needs HTTPS).
# COOKIE_SAMESITE=lax

# Behind a load balancer or reverse proxy (Render, Railway, Nginx, Cloudflare), set this so
# sign-in limits count each visitor by their real IP: "true", a number of proxy hops, or proxy IPs.
# TRUST_PROXY=true

# "production" (the default) turns on safety checks and HTTPS-only login cookies.
# For a quick local test over plain http://localhost, set it to development.
# NODE_ENV=development

# Sign-up emails: Gmail App Password, any SMTP server, or Resend (see apps/api/.env.example).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
# RESEND_API_KEY=

# AI transform step
# GEMINI_API_KEY=

# Used by the Prisma CLI when running migrations from your machine (not by compose).
DATABASE_URL="postgresql://flowforge:password@localhost:5433/flowforge?schema=public"
