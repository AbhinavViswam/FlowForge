# Settings for `docker compose up` on your own server. Copy to .env (next to
# docker-compose.yml) and fill in. For Render + Supabase, see DEPLOY.md instead.
# FlowForge refuses to start in production if a secret below is missing,
# shorter than 32 characters, or a placeholder.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Database password (use the generated hex value: other characters can break the URL).
POSTGRES_PASSWORD=

# Signs login sessions. Changing it signs everyone out.
JWT_SECRET=

# Encrypts saved passwords and connection strings. Never change it once set,
# or saved values can no longer be decrypted. Keep a copy somewhere safe.
ENCRYPTION_KEY=

# The app's public address once deployed (HTTPS), e.g. https://flowforge.example.com.
# The website and API share this address.
# PUBLIC_URL=

# Only if you host the website somewhere else: that website's address (allowed to
# sign in and call the API), and COOKIE_SAMESITE=none if it's on a different domain.
# CORS_ORIGINS=
# COOKIE_SAMESITE=lax

# Behind a load balancer or reverse proxy (Render, Railway, Nginx, Cloudflare), set this so
# sign-in limits count each visitor by their real IP: "true", a number of proxy hops, or proxy IPs.
# TRUST_PROXY=true

# "production" (the default) turns on safety checks and HTTPS-only login cookies.
# For a quick local test over plain http://localhost, set it to development.
# NODE_ENV=development

# Sign-up emails: Brevo API key (HTTPS), Gmail App Password, any SMTP server, or Resend
# (see apps/api/.env.example). EMAIL_FROM must be a sender verified with the provider.
# BREVO_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
# RESEND_API_KEY=

# AI transform step
# GEMINI_API_KEY=

# Used by the Prisma CLI when running migrations from your machine (not by compose).
DATABASE_URL="postgresql://flowforge:password@localhost:5433/flowforge?schema=public"
