# FlowForge API settings. Copy to apps/api/.env and fill in.

DATABASE_URL="postgresql://flowforge:password@localhost:5433/flowforge?schema=public"

# Signs login sessions. Use a long random value in production.
JWT_SECRET=

# Encrypts saved passwords and connection strings.
# Never change it once set, or saved connections can't be decrypted.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Browser access -------------------------------------------------------
# Your website address(es), comma-separated. localhost is always allowed in development.
# CORS_ORIGINS=https://app.example.com
# Use "none" only when the website and API are on different domains
# (e.g. app.vercel.app + api.onrender.com). Requires HTTPS.
# COOKIE_SAMESITE=lax

# Behind a load balancer or reverse proxy (Render, Railway, Nginx, Cloudflare), set this so
# sign-in limits count each visitor by their real IP: "true", a number of proxy hops, or proxy IPs.
# TRUST_PROXY=true

# --- Sign-up emails (6-digit confirmation codes) --------------------------
# Option 0: Brevo (HTTPS API; works on hosts that block SMTP, like Render's free plan).
# Brevo -> Settings -> SMTP & API -> API keys. EMAIL_FROM must be a verified sender.
# BREVO_API_KEY=

# Option 1: Gmail. Needs 2-Step Verification and an App Password from
# https://myaccount.google.com/apppasswords (spaces in the password are fine).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Option 2: any SMTP server (used instead of Gmail when set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Option 3: Resend (used only when no Gmail/SMTP settings are set)
# RESEND_API_KEY=

# Test your settings with: npm run mail:test -w @flowforge/api -- you@example.com
# With none of these set, codes are printed in the API log (development only).

# --- AI transform step (the editor's Test button runs here) ---------------
# GEMINI_API_KEY=

# LOCAL DEVELOPMENT ONLY: lets steps and triggers reach localhost / private networks.
# Never set this on a public server.
# ALLOW_PRIVATE_NETWORK=true
