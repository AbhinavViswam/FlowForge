# FlowForge worker settings (runs the automations). Copy to apps/worker/.env and fill in.

DATABASE_URL="postgresql://flowforge:password@localhost:5433/flowforge?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# Must be exactly the same value as ENCRYPTION_KEY in apps/api/.env.
ENCRYPTION_KEY=

# --- Default sender for "Send email" steps that don't pick a saved connection ---
# Users normally add their own Gmail under Account -> Email connections instead.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# EMAIL_FROM=
# SMTP_HOST= / SMTP_PORT= / SMTP_SECURE= / SMTP_USER= / SMTP_PASS=
# RESEND_API_KEY=

# --- AI transform step -----------------------------------------------------
# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Fallback: used only if no GEMINI_API_KEY is set.
# ANTHROPIC_API_KEY=

# LOCAL DEVELOPMENT ONLY: lets steps and triggers reach localhost / private networks.
# Never set this on a public server.
# ALLOW_PRIVATE_NETWORK=true
