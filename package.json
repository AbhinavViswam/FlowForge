{
  "name": "flowforge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @flowforge/shared && npm run build -w @flowforge/workflow-engine && npm run build -w @flowforge/api -w @flowforge/web",
    "dev": "concurrently \"npm run dev -w @flowforge/api\" \"npm run dev -w @flowforge/web\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@prisma/client": "^5.22.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
